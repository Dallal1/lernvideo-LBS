<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="lbs.videomanager.team.controllers.Team"
    displayBlock="true">
    <VBox class="teamPage">
        <Title
            text="Team"
            level="H1"
            class="teamTitle"/>

        <Text
            text="Die Menschen hinter VideoManager"
            class="teamSubtitle"/>

        <FlexBox
            renderType="Div"
            items="{path: 'team>/members', templateShareable: false}"
            class="teamGrid">
            <VBox class="teamCard">
                <Title
                    text="{team>name}"
                    level="H2"
                    wrapping="true"
                    class="teamName"/>

                <Text
                    text="{team>position}"
                    class="teamPosition"/>
            </VBox>
        </FlexBox>
    </VBox>
</mvc:View>
