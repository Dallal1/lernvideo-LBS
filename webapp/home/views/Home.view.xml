<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="lbs.videomanager.home.controllers.Home"
    displayBlock="true">
    <VBox class="homePage">
        <Title
            text="Willkommen"
            level="H1"
            class="homeTitle"/>

        <HBox
            wrap="Wrap"
            class="homeCards">
            <VBox
                visible="false"
                class="homeCard">
                <VBox
                    alignItems="Center"
                    justifyContent="Center"
                    class="cardIllustration">
                    <core:Icon
                        src="sap-icon://video"
                        decorative="true"/>
                </VBox>

                <Title
                    text="Videos"
                    level="H2"
                    class="cardTitle"/>

                <Text
                    text="Hier findest du später unsere Lernvideos."
                    class="cardDescription"/>

                <Button
                    text="Videos ansehen"
                    press=".onOpenVideos"
                    type="Emphasized"
                    class="cardPlaceholder"/>
            </VBox>

            <VBox class="homeCard">
                <VBox
                    alignItems="Center"
                    justifyContent="Center"
                    class="cardIllustration">
                    <core:Icon
                        src="sap-icon://video"
                        decorative="true"/>
                </VBox>

                <Title
                    text="Videos"
                    level="H2"
                    class="cardTitle"/>

                <Text
                    text="Entdecke ausgewählte Lernvideos zu IT und Programmierung."
                    class="cardDescription"/>

                <Button
                    text="Videos ansehen"
                    press=".onOpenModule2"
                    type="Emphasized"
                    class="cardPlaceholder"/>
            </VBox>

            <VBox class="homeCard">
                <VBox
                    alignItems="Center"
                    justifyContent="Center"
                    class="cardIllustration">
                    <core:Icon
                        src="sap-icon://group"
                        decorative="true"/>
                </VBox>

                <Title
                    text="Team"
                    level="H2"
                    class="cardTitle"/>

                <Text
                    text="Lerne die Menschen hinter unserem Projekt kennen."
                    class="cardDescription"/>

                <Button
                    text="Über uns"
                    press=".onOpenTeam"
                    type="Emphasized"
                    class="cardPlaceholder"/>
            </VBox>
        </HBox>
    </VBox>
</mvc:View>
