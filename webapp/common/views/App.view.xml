<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="lbs.videomanager.common.controllers.App"
    displayBlock="true"
    height="100%">
    <VBox
        class="appShell"
        height="100%">
        <Toolbar class="appHeader">
            <core:Icon
                src="sap-icon://media-play"
                decorative="true"
                class="brandIcon"/>

            <HBox
                alignItems="Center"
                class="brandName">
                <Title
                    text="Video"
                    level="H2"
                    class="brandVideo"/>

                <Title
                    text="Manager"
                    level="H2"
                    class="brandManager"/>
            </HBox>

            <ToolbarSpacer />

            <ToggleButton
                id="menuButton"
                icon="sap-icon://menu2"
                tooltip="Menü öffnen"
                type="Transparent"
                press=".onToggleMenu"/>
        </Toolbar>

        <HBox
            class="appBody"
            fitContainer="true"
            alignItems="Stretch">
            <layoutData>
                <FlexItemData
                    growFactor="1"
                    baseSize="0%"/>
            </layoutData>

            <VBox
                id="navigation"
                visible="false"
                class="appNavigation">
                <ToggleButton
                    id="homeNavigation"
                    text="Home"
                    icon="sap-icon://home"
                    type="Transparent"
                    press=".onHome"
                    class="navigationButton"/>

                <ToggleButton
                    id="videosNavigation"
                    text="Videos"
                    icon="sap-icon://media-play"
                    type="Transparent"
                    press=".onVideos"
                    class="navigationButton"/>

                <Button
                    text="Team"
                    icon="sap-icon://group"
                    type="Transparent"
                    enabled="false"
                    tooltip="Team – noch nicht verfügbar"
                    class="navigationButton"/>
            </VBox>

            <VBox
                id="pageContent"
                class="appContent">
                <layoutData>
                    <FlexItemData
                        growFactor="1"
                        shrinkFactor="1"
                        baseSize="0%"/>
                </layoutData>

            </VBox>
        </HBox>
    </VBox>
</mvc:View>
