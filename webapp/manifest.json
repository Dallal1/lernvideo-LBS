{
  "_version": "1.65.0",
  "sap.app": {
    "id": "lbs.videomanager",
    "type": "application",
    "title": "VideoManager",
    "description": "Startseite des Lernvideo-Schulprojekts",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.unified": {}
      }
    },
    "rootView": {
      "viewName": "lbs.videomanager.common.views.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "resources": {
      "css": [
        { "uri": "common/css/style.css" },
        { "uri": "videos/css/videos.css" },
        { "uri": "module2/css/module2.css" }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.ui.core.routing.Router",
        "type": "View",
        "viewType": "XML",
        "async": true,
        "controlId": "pageContent",
        "controlAggregation": "items",
        "clearControlAggregation": true
      },
      "routes": [
        { "pattern": "", "name": "home", "target": "home" },
        { "pattern": "videos", "name": "videos", "target": "videos" },
        { "pattern": "module2", "name": "module2", "target": "module2" }
      ],
      "targets": {
        "home": {
          "id": "home",
          "name": "lbs.videomanager.home.views.Home"
        },
        "videos": {
          "id": "videos",
          "name": "lbs.videomanager.videos.views.Videos"
        },
        "module2": {
          "id": "module2",
          "name": "lbs.videomanager.module2.views.Module2"
        }
      }
    }
  }
}
